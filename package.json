{
  "name": "justgo-mcp",
  "version": "0.1.0",
  "description": "MCP server for JustGo: lets Claude, ChatGPT and other MCP clients look up members, their memberships and credentials, events and event bookings, and organisations in a JustGo sports membership platform, and (when enabled) change the dates of a member's membership.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node test/e2e.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "justgo",
    "claude",
    "sports-membership"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "justgo-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
